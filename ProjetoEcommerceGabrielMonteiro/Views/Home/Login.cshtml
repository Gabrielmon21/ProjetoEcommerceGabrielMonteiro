@model ProjetoEcommerceGabrielMonteiro.Models.LoginViewModel
@{
    ViewBag.Title = "Login";
}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card mt-5">
                <div class="card-header">
                    <h2 class="text-center">🔐 Login</h2>
                </div>
                <div class="card-body">
                    @using (Html.BeginForm())
                    {
                        @Html.AntiForgeryToken()

                        <div class="form-group">
                            @Html.LabelFor(m => m.Email)
                            @Html.TextBoxFor(m => m.Email, new { @class = "form-control", placeholder = "seu@email.com" })
                            @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger" })
                        </div>

                        <div class="form-group">
                            @Html.LabelFor(m => m.Senha)
                            @Html.PasswordFor(m => m.Senha, new { @class = "form-control", placeholder = "Sua senha" })
                            @Html.ValidationMessageFor(m => m.Senha, "", new { @class = "text-danger" })
                        </div>

                        <div class="form-group">
                            <label>Tipo de Usuário:</label>
                            <select name="TipoUsuario" class="form-control">
                                <option value="cliente">👤 Cliente</option>
                                <option value="admin">⚙️ Administrador</option>
                            </select>
                        </div>

                        <button type="submit" class="btn btn-primary btn-block">Entrar</button>

                        <div class="text-center mt-3">
                            <p>Não tem conta? @Html.ActionLink("Registre-se aqui", "Registrar")</p>
                        </div>

                        <!-- Credenciais de teste -->
                        <div class="mt-3 p-3 bg-light rounded">
                            <small class="text-muted">
                                <strong>Credenciais de Teste:</strong><br />
                                Admin: admin@gabrielmonteiro.com / 123456<br />
                                Cliente: cliente@teste.com / 123456
                            </small>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
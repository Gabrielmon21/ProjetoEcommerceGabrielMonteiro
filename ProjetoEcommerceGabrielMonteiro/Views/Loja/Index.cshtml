@model List<ProjetoEcommerceGabrielMonteiro.Models.Produto>
@{
    ViewBag.Title = "Nossa Loja";
}

<div class="container">
    <h2>🛍️ Nossa Loja</h2>
    <p class="lead">@ViewBag.Message</p>

    <div class="row">
        @foreach (var produto in Model)
        {
            <div class="col-md-4 mb-4">
                <div class="card h-100">
                    @if (!string.IsNullOrEmpty(produto.Imagem))
                    {
                        <img src="@produto.Imagem" class="card-img-top" alt="@produto.Nome" style="height: 200px; object-fit: cover;">
                    }
                    else
                    {
                        <div class="card-img-top bg-light d-flex align-items-center justify-content-center" style="height: 200px;">
                            <span class="text-muted">📷 Sem imagem</span>
                        </div>
                    }

                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">@produto.Nome</h5>
                        <p class="card-text">@produto.DescricaoCurta</p>
                        <p class="card-text"><strong class="text-success">R$ @produto.Preco.ToString("N2")</strong></p>
                        <p class="card-text">
                            <small class="text-muted">
                                Estoque: @produto.QuantidadeEstoque | Marca: @produto.Marca
                            </small>
                        </p>

                        <div class="mt-auto">
                            @if (produto.QuantidadeEstoque > 0)
                            {
                                @Html.ActionLink("🛒 Adicionar ao Carrinho", "Adicionar", "Carrinho",
                                    new { id = produto.Id },
                                    new { @class = "btn btn-primary btn-block" })
                            }
                            else
                            {
                                <button class="btn btn-secondary btn-block" disabled>Fora de Estoque</button>
                            }

                            @Html.ActionLink("🔍 Detalhes", "DetalhesProduto", "Loja",
                                new { id = produto.Id },
                                new { @class = "btn btn-outline-info btn-block mt-1" })
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    @if (Model.Count == 0)
    {
        <div class="text-center py-5">
            <h4>📭 Nenhum produto disponível</h4>
            <p>Volte em breve para conferir nossas novidades!</p>
        </div>
    }
</div>
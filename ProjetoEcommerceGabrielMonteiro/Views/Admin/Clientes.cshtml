@model List<ProjetoEcommerceGabrielMonteiro.Models.Cliente>
@{
    ViewBag.Title = "Gerenciar Clientes";

    int total = Model != null ? Model.Count : 0;
    int comTelefone = total > 0 ? Model.Count(c => !string.IsNullOrEmpty(c.NumContato)) : 0;
    int comEndereco = total > 0 ? Model.Count(c => !string.IsNullOrEmpty(c.Endereco)) : 0;
    int pctTelefone = total > 0 ? (int)Math.Round(comTelefone * 100.0 / total) : 0;
    int pctEndereco = total > 0 ? (int)Math.Round(comEndereco * 100.0 / total) : 0;
}

<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet" />

<style>
    .cx {
        --cx-base: #070b14;
        --cx-surface: #0e1626;
        --cx-surface-2: #131e33;
        --cx-line: #1d2a44;
        --cx-text: #e6edf7;
        --cx-muted: #8a9bb8;
        --cx-cyan: #22d3ee;
        --cx-violet: #8b5cf6;
        --cx-danger: #f43f5e;
        --cx-warn: #f59e0b;
        --cx-ok: #34d399;
        position: relative;
        margin: 1.5rem 0;
        padding: 2rem;
        border: 1px solid var(--cx-line);
        border-radius: 18px;
        color: var(--cx-text);
        font-family: 'Manrope', system-ui, -apple-system, 'Segoe UI', sans-serif;
        background: radial-gradient(900px 380px at 88% -10%, rgba(139, 92, 246, .18), transparent 60%), radial-gradient(700px 320px at -5% 0%, rgba(34, 211, 238, .14), transparent 60%), linear-gradient(rgba(34, 211, 238, .035) 1px, transparent 1px) 0 0 / 34px 34px, linear-gradient(90deg, rgba(34, 211, 238, .035) 1px, transparent 1px) 0 0 / 34px 34px, var(--cx-base);
        overflow: hidden;
    }

        .cx *, .cx *::before, .cx *::after {
            box-sizing: border-box;
        }

    /* Cabeçalho */
    .cx-head {
        display: flex;
        flex-wrap: wrap;
        align-items: flex-end;
        justify-content: space-between;
        gap: 1rem;
        margin-bottom: 1.75rem;
    }

    .cx-title {
        margin: 0;
        font-family: 'Space Grotesk', 'Manrope', sans-serif;
        font-size: clamp(1.9rem, 3.4vw, 2.7rem);
        font-weight: 700;
        letter-spacing: -.02em;
        line-height: 1.05;
        background: linear-gradient(100deg, #fff 30%, var(--cx-cyan) 100%);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
    }

    .cx-sub {
        margin: .45rem 0 0;
        color: var(--cx-muted);
        font-size: .95rem;
    }

    .cx-tools {
        display: flex;
        flex-wrap: wrap;
        gap: .6rem;
        align-items: center;
    }

    .cx-search {
        position: relative;
    }

        .cx-search svg {
            position: absolute;
            left: 12px;
            top: 50%;
            transform: translateY(-50%);
            width: 16px;
            height: 16px;
            color: var(--cx-muted);
            pointer-events: none;
        }

        .cx-search input {
            width: 260px;
            max-width: 100%;
            padding: .6rem .9rem .6rem 2.2rem;
            border-radius: 10px;
            border: 1px solid var(--cx-line);
            background: var(--cx-surface);
            color: var(--cx-text);
            font: inherit;
            font-size: .92rem;
            transition: border-color .2s, box-shadow .2s;
        }

            .cx-search input::placeholder {
                color: var(--cx-muted);
            }

            .cx-search input:focus {
                outline: none;
                border-color: var(--cx-cyan);
                box-shadow: 0 0 0 3px rgba(34, 211, 238, .18);
            }

    .cx-btn {
        display: inline-flex;
        align-items: center;
        gap: .5rem;
        padding: .6rem 1rem;
        border-radius: 10px;
        border: 1px solid var(--cx-line);
        background: var(--cx-surface-2);
        color: var(--cx-text);
        font: inherit;
        font-size: .92rem;
        font-weight: 600;
        cursor: pointer;
        transition: border-color .2s, background .2s;
    }

        .cx-btn:hover {
            border-color: var(--cx-cyan);
            background: #16233c;
        }

        .cx-btn svg {
            width: 16px;
            height: 16px;
        }

    .cx a:focus-visible, .cx button:focus-visible, .cx input:focus-visible {
        outline: 2px solid var(--cx-cyan);
        outline-offset: 2px;
    }

    /* Alertas */
    .cx-alert {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        margin-bottom: 1.25rem;
        padding: .85rem 1.1rem;
        border-radius: 12px;
        border: 1px solid;
        font-size: .93rem;
    }

    .cx-alert--ok {
        color: var(--cx-ok);
        background: rgba(52, 211, 153, .08);
        border-color: rgba(52, 211, 153, .35);
    }

    .cx-alert--erro {
        color: #fb7185;
        background: rgba(244, 63, 94, .08);
        border-color: rgba(244, 63, 94, .35);
    }

    .cx-alert button {
        background: none;
        border: 0;
        color: inherit;
        font-size: 1.3rem;
        line-height: 1;
        cursor: pointer;
        opacity: .75;
    }

        .cx-alert button:hover {
            opacity: 1;
        }

    /* Indicadores */
    .cx-stats {
        display: grid;
        grid-template-columns: 1.1fr 1fr 1fr;
        gap: 1rem;
        margin-bottom: 1.75rem;
    }

    .cx-stat {
        padding: 1.15rem 1.3rem;
        border: 1px solid var(--cx-line);
        border-radius: 14px;
        background: linear-gradient(180deg, rgba(19, 30, 51, .9), rgba(14, 22, 38, .9));
    }

    .cx-stat--main {
        border-color: rgba(34, 211, 238, .4);
        box-shadow: 0 0 32px -12px rgba(34, 211, 238, .5);
    }

    .cx-stat-value {
        font-family: 'Space Grotesk', sans-serif;
        font-size: 2.3rem;
        font-weight: 700;
        line-height: 1;
        letter-spacing: -.02em;
    }

    .cx-stat-label {
        margin-top: .4rem;
        color: var(--cx-muted);
        font-size: .88rem;
    }

    .cx-stat-row {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: .75rem;
    }

    .cx-stat-pct {
        color: var(--cx-muted);
        font-size: .85rem;
        font-weight: 600;
    }

    .cx-meter {
        margin-top: .85rem;
        height: 6px;
        border-radius: 99px;
        background: var(--cx-line);
        overflow: hidden;
    }

        .cx-meter > span {
            display: block;
            height: 100%;
            width: 0;
            border-radius: inherit;
            background: linear-gradient(90deg, var(--cx-cyan), var(--cx-violet));
            animation: cx-fill 1.1s cubic-bezier(.2, .8, .2, 1) .15s forwards;
        }

    @@keyframes cx-fill {
        to {
            width: var(--w);
        }
    }

    /* Tabela */
    .cx-panel {
        border: 1px solid var(--cx-line);
        border-radius: 14px;
        background: rgba(14, 22, 38, .92);
        overflow: hidden;
    }

    .cx-panel-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 1rem 1.3rem;
        border-bottom: 1px solid var(--cx-line);
        font-family: 'Space Grotesk', sans-serif;
        font-weight: 600;
        font-size: 1.05rem;
    }

    .cx-count {
        color: var(--cx-muted);
        font-family: 'Manrope', sans-serif;
        font-weight: 500;
        font-size: .88rem;
    }

    .cx-scroll {
        overflow-x: auto;
    }

    .cx-table {
        width: 100%;
        border-collapse: collapse;
    }

        .cx-table th {
            padding: .8rem 1.3rem;
            text-align: left;
            color: var(--cx-muted);
            font-size: .82rem;
            font-weight: 600;
            background: rgba(7, 11, 20, .55);
            white-space: nowrap;
        }

        .cx-table td {
            padding: .85rem 1.3rem;
            border-top: 1px solid var(--cx-line);
            font-size: .93rem;
            vertical-align: middle;
        }

        .cx-table tbody tr {
            transition: background .15s;
        }

            .cx-table tbody tr:hover {
                background: rgba(34, 211, 238, .05);
            }

    .cx-id {
        color: var(--cx-muted);
        font-variant-numeric: tabular-nums;
    }

    .cx-person {
        display: flex;
        align-items: center;
        gap: .8rem;
    }

    .cx-avatar {
        flex: none;
        width: 38px;
        height: 38px;
        display: grid;
        place-items: center;
        border-radius: 11px;
        font-family: 'Space Grotesk', sans-serif;
        font-weight: 700;
        font-size: 1rem;
        color: #06121c;
        background: linear-gradient(135deg, var(--cx-cyan), var(--cx-violet));
    }

    .cx-name {
        font-weight: 700;
    }

    .cx-mail {
        color: var(--cx-muted);
        font-size: .85rem;
    }

    .cx-empty-cell {
        color: var(--cx-muted);
        font-style: italic;
    }

    .cx-tag {
        display: inline-block;
        padding: .18rem .6rem;
        border-radius: 99px;
        font-size: .78rem;
        font-weight: 600;
        color: var(--cx-cyan);
        background: rgba(34, 211, 238, .1);
        border: 1px solid rgba(34, 211, 238, .25);
    }

    .cx-actions {
        display: flex;
        gap: .4rem;
        justify-content: flex-end;
    }

    .cx-icon {
        width: 34px;
        height: 34px;
        display: grid;
        place-items: center;
        border-radius: 9px;
        border: 1px solid var(--cx-line);
        background: var(--cx-surface-2);
        color: var(--cx-muted);
        transition: color .15s, border-color .15s, background .15s;
    }

        .cx-icon svg {
            width: 16px;
            height: 16px;
        }

    .cx-icon--ver:hover {
        color: var(--cx-cyan);
        border-color: var(--cx-cyan);
        background: rgba(34, 211, 238, .08);
    }

    .cx-icon--editar:hover {
        color: var(--cx-warn);
        border-color: var(--cx-warn);
        background: rgba(245, 158, 11, .08);
    }

    .cx-icon--excluir:hover {
        color: var(--cx-danger);
        border-color: var(--cx-danger);
        background: rgba(244, 63, 94, .08);
    }

    .cx-nores {
        display: none;
        padding: 2rem 1.3rem;
        text-align: center;
        color: var(--cx-muted);
    }

    /* Estado vazio */
    .cx-empty {
        padding: 3.5rem 1.5rem;
        text-align: center;
    }

    .cx-empty-icon {
        width: 64px;
        height: 64px;
        margin: 0 auto 1.1rem;
        display: grid;
        place-items: center;
        border-radius: 18px;
        color: var(--cx-cyan);
        background: rgba(34, 211, 238, .08);
        border: 1px solid rgba(34, 211, 238, .3);
    }

        .cx-empty-icon svg {
            width: 30px;
            height: 30px;
        }

    .cx-empty h4 {
        margin: 0 0 .4rem;
        font-family: 'Space Grotesk', sans-serif;
        font-size: 1.3rem;
    }

    .cx-empty p {
        margin: 0 auto;
        max-width: 42ch;
        color: var(--cx-muted);
    }

    /* Responsivo */
    @@media (max-width: 860px) {
        .cx {
            padding: 1.25rem;
        }

        .cx-stats {
            grid-template-columns: 1fr;
        }

        .cx-search input {
            width: 100%;
        }

        .cx-search {
            flex: 1 1 100%;
        }
    }

    @@media (max-width: 720px) {
        .cx-table thead {
            display: none;
        }

        .cx-table, .cx-table tbody, .cx-table tr, .cx-table td {
            display: block;
            width: 100%;
        }

            .cx-table tr {
                padding: .6rem 0;
                border-top: 1px solid var(--cx-line);
            }

            .cx-table tbody tr:first-child {
                border-top: 0;
            }

            .cx-table td {
                border: 0;
                padding: .35rem 1.1rem;
                display: flex;
                justify-content: space-between;
                gap: 1rem;
            }

                .cx-table td[data-label]::before {
                    content: attr(data-label);
                    color: var(--cx-muted);
                    font-size: .82rem;
                }

        .cx-actions {
            justify-content: flex-start;
        }
    }

    @@media (prefers-reduced-motion: reduce) {
        .cx-meter > span {
            animation: none;
            width: var(--w);
        }

        .cx * {
            transition: none !important;
        }
    }
</style>

<div class="cx">

    <div class="cx-head">
        <div>
            <h2 class="cx-title">Clientes</h2>
            <p class="cx-sub">@total @(total == 1 ? "cliente cadastrado" : "clientes cadastrados") na loja</p>
        </div>

        <div class="cx-tools">
            @if (total > 0)
            {
                <label class="cx-search">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m21 21-4.3-4.3" /></svg>
                    <input type="search" id="cxBusca" placeholder="Buscar por nome, e-mail ou telefone" aria-label="Buscar clientes" autocomplete="off" />
                </label>
            }
            <button type="button" class="cx-btn" onclick="location.reload()">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12a9 9 0 1 1-2.64-6.36" /><path d="M21 3v6h-6" /></svg>
                Atualizar
            </button>
        </div>
    </div>

    @if (TempData["Sucesso"] != null)
    {
        <div class="cx-alert cx-alert--ok" role="status">
            <span>@TempData["Sucesso"]</span>
            <button type="button" aria-label="Fechar aviso" onclick="this.parentNode.remove()">&times;</button>
        </div>
    }

    @if (TempData["Erro"] != null)
    {
        <div class="cx-alert cx-alert--erro" role="alert">
            <span>@TempData["Erro"]</span>
            <button type="button" aria-label="Fechar aviso" onclick="this.parentNode.remove()">&times;</button>
        </div>
    }

    @if (total > 0)
    {
        <div class="cx-stats">
            <div class="cx-stat cx-stat--main">
                <div class="cx-stat-value">@total</div>
                <div class="cx-stat-label">Total de clientes</div>
            </div>

            <div class="cx-stat">
                <div class="cx-stat-row">
                    <div class="cx-stat-value">@comTelefone</div>
                    <div class="cx-stat-pct">@pctTelefone%</div>
                </div>
                <div class="cx-stat-label">Com telefone</div>
                <div class="cx-meter" role="progressbar" aria-valuenow="@pctTelefone" aria-valuemin="0" aria-valuemax="100" aria-label="Clientes com telefone"><span style="--w:@(pctTelefone)%"></span></div>
            </div>

            <div class="cx-stat">
                <div class="cx-stat-row">
                    <div class="cx-stat-value">@comEndereco</div>
                    <div class="cx-stat-pct">@pctEndereco%</div>
                </div>
                <div class="cx-stat-label">Com endereço</div>
                <div class="cx-meter" role="progressbar" aria-valuenow="@pctEndereco" aria-valuemin="0" aria-valuemax="100" aria-label="Clientes com endereço"><span style="--w:@(pctEndereco)%"></span></div>
            </div>
        </div>

        <div class="cx-panel">
            <div class="cx-panel-head">
                <span>Todos os clientes</span>
                <span class="cx-count" id="cxContagem">@total @(total == 1 ? "registro" : "registros")</span>
            </div>

            <div class="cx-scroll">
                <table class="cx-table" id="cxTabela">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Cliente</th>
                            <th>Telefone</th>
                            <th>Cadastro</th>
                            <th style="text-align:right">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var cliente in Model)
                        {
                            var inicial = string.IsNullOrWhiteSpace(cliente.Nome) ? "?" : cliente.Nome.Trim().Substring(0, 1).ToUpper();

                            <tr>
                                <td class="cx-id" data-label="ID">#@cliente.Id</td>
                                <td data-label="Cliente">
                                    <div class="cx-person">
                                        <span class="cx-avatar" aria-hidden="true">@inicial</span>
                                        <div>
                                            <div class="cx-name">@cliente.Nome</div>
                                            <div class="cx-mail">@cliente.Email</div>
                                        </div>
                                    </div>
                                </td>
                                <td data-label="Telefone">
                                    @if (string.IsNullOrEmpty(cliente.NumContato))
                                    {
                                        <span class="cx-empty-cell">Não informado</span>
                                    }
                                    else
                                    {
                                        <span>@cliente.NumContato</span>
                                    }
                                </td>
                                <td data-label="Cadastro"><span class="cx-tag">@cliente.DataCadastro.ToString("dd/MM/yyyy")</span></td>
                                <td data-label="Ações">
                                    <div class="cx-actions">
                                        <a class="cx-icon cx-icon--ver" href="@Url.Action("DetalhesCliente", "Admin", new { id = cliente.Id })" title="Ver detalhes" aria-label="Ver detalhes de @cliente.Nome">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7-10-7-10-7Z" /><circle cx="12" cy="12" r="3" /></svg>
                                        </a>
                                        <a class="cx-icon cx-icon--editar" href="@Url.Action("EditarCliente", "Admin", new { id = cliente.Id })" title="Editar cliente" aria-label="Editar @cliente.Nome">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20h9" /><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z" /></svg>
                                        </a>
                                        <a class="cx-icon cx-icon--excluir" href="@Url.Action("ExcluirCliente", "Admin", new { id = cliente.Id })" title="Excluir cliente" aria-label="Excluir @cliente.Nome"
                                           onclick="return confirm('Tem certeza que deseja excluir este cliente? Esta ação não pode ser desfeita.')">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 6h18" /><path d="M8 6V4h8v2" /><path d="M19 6l-1 14H6L5 6" /><path d="M10 11v6M14 11v6" /></svg>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="cx-nores" id="cxSemResultado">Nenhum cliente encontrado para essa busca.</div>
        </div>
    }
    else
    {
        <div class="cx-panel">
            <div class="cx-empty">
                <div class="cx-empty-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><path d="M22 21v-2a4 4 0 0 0-3-3.87" /><path d="M16 3.13a4 4 0 0 1 0 7.75" /></svg>
                </div>
                <h4>Nenhum cliente cadastrado</h4>
                <p>Os clientes aparecem aqui assim que criam uma conta na loja. Para testar, faça um cadastro como cliente.</p>
            </div>
        </div>
    }

</div>

@section Scripts {
    <script>
        (function () {
            var busca = document.getElementById('cxBusca');
            var tabela = document.getElementById('cxTabela');
            if (!busca || !tabela) return;

            var linhas = tabela.querySelectorAll('tbody tr');
            var contagem = document.getElementById('cxContagem');
            var vazio = document.getElementById('cxSemResultado');

            busca.addEventListener('input', function () {
                var termo = busca.value.trim().toLowerCase();
                var visiveis = 0;

                linhas.forEach(function (tr) {
                    var mostrar = !termo || tr.textContent.toLowerCase().indexOf(termo) !== -1;
                    tr.style.display = mostrar ? '' : 'none';
                    if (mostrar) visiveis++;
                });

                contagem.textContent = visiveis + (visiveis === 1 ? ' registro' : ' registros');
                vazio.style.display = visiveis === 0 ? 'block' : 'none';
            });
        })();
    </script>
}

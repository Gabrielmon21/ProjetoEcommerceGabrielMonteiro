@model ProjetoEcommerceGabrielMonteiro.Models.Produto
@{
    ViewBag.Title = "Cadastrar Produto";
}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header">
                    <h2 class="text-center">➕ Cadastrar Novo Produto</h2>
                </div>
                <div class="card-body">
                    @using (Html.BeginForm())
                    {
                        @Html.AntiForgeryToken()

                        <div class="form-group">
                            @Html.LabelFor(m => m.Nome)
                            @Html.TextBoxFor(m => m.Nome, new { @class = "form-control", placeholder = "Nome do produto" })
                            @Html.ValidationMessageFor(m => m.Nome, "", new { @class = "text-danger" })
                        </div>

                        <div class="form-group">
                            @Html.LabelFor(m => m.DescricaoCurta)
                            @Html.TextAreaFor(m => m.DescricaoCurta, new { @class = "form-control", rows = "2", placeholder = "Descrição breve do produto" })
                            @Html.ValidationMessageFor(m => m.DescricaoCurta, "", new { @class = "text-danger" })
                        </div>

                        <div class="form-group">
                            @Html.LabelFor(m => m.DescricaoLonga)
                            @Html.TextAreaFor(m => m.DescricaoLonga, new { @class = "form-control", rows = "4", placeholder = "Descrição detalhada do produto" })
                            @Html.ValidationMessageFor(m => m.DescricaoLonga, "", new { @class = "text-danger" })
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.LabelFor(m => m.Preco)
                                    <div class="input-group">
                                        <div class="input-group-prepend">
                                            <span class="input-group-text">R$</span>
                                        </div>
                                        @Html.TextBoxFor(m => m.Preco, new
                                        {
                                            @class = "form-control",
                                            type = "number",
                                            step = "0.01",
                                            placeholder = "0,00",
                                            min = "0.01"
                                        })
                                    </div>
                                    @Html.ValidationMessageFor(m => m.Preco, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.LabelFor(m => m.QuantidadeEstoque)
                                    @Html.TextBoxFor(m => m.QuantidadeEstoque, new
                                    {
                                        @class = "form-control",
                                        type = "number",
                                        placeholder = "0",
                                        min = "0"
                                    })
                                    @Html.ValidationMessageFor(m => m.QuantidadeEstoque, "", new { @class = "text-danger" })
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.LabelFor(m => m.CategoriaId)
                                    <select name="CategoriaId" class="form-control">
                                        <option value="1">📱 Eletrônicos</option>
                                        <option value="2">👕 Roupas</option>
                                        <option value="3">🏠 Casa e Decoração</option>
                                        <option value="4">📚 Livros</option>
                                        <option value="5">⚽ Esportes</option>
                                    </select>
                                    @Html.ValidationMessageFor(m => m.CategoriaId, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.LabelFor(m => m.Marca)
                                    @Html.TextBoxFor(m => m.Marca, new { @class = "form-control", placeholder = "Marca do produto" })
                                    @Html.ValidationMessageFor(m => m.Marca, "", new { @class = "text-danger" })
                                </div>
                            </div>
                        </div>

                        <div class="form-group">
                            @Html.LabelFor(m => m.Imagem)
                            @Html.TextBoxFor(m => m.Imagem, new { @class = "form-control", placeholder = "URL da imagem (opcional)" })
                            <small class="form-text text-muted">Ex: https://exemplo.com/imagem.jpg</small>
                        </div>

                        <div class="form-group form-check">
                            @Html.CheckBoxFor(m => m.Ativo, new { @class = "form-check-input", @checked = "checked" })
                            @Html.LabelFor(m => m.Ativo, "Produto ativo para venda", new { @class = "form-check-label" })
                        </div>

                        <div class="form-group">
                            <button type="submit" class="btn btn-success btn-lg btn-block">
                                💾 Salvar Produto
                            </button>
                            @Html.ActionLink("↩️ Voltar", "Produtos", "Admin", null, new { @class = "btn btn-secondary btn-block mt-2" })
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Validação básica no cliente
        $(document).ready(function () {
            $('form').submit(function () {
                var preco = $('#Preco').val();
                if (preco <= 0) {
                    alert('O preço deve ser maior que zero!');
                    return false;
                }
                return true;
            });
        });
    </script>
}
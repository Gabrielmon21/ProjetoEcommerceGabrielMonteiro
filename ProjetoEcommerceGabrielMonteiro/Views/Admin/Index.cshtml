@{
    ViewBag.Title = "Área Administrativa";
}

<div class="container">
    <h2>⚙️ Área Administrativa</h2>
    <p class="lead">@ViewBag.Message</p>

    <div class="row mt-4">
        <div class="col-md-4">
            <div class="card text-white bg-primary mb-3">
                <div class="card-body">
                    <h5 class="card-title">📦 Produtos</h5>
                    <p class="card-text">Gerencie seu catálogo de produtos</p>
                    @Html.ActionLink("Gerenciar Produtos", "Produtos", "Admin", null, new { @class = "btn btn-light" })
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card text-white bg-success mb-3">
                <div class="card-body">
                    <h5 class="card-title">📋 Pedidos</h5>
                    <p class="card-text">Visualize e gerencie pedidos</p>
                    @Html.ActionLink("Ver Pedidos", "Pedidos", "Admin", null, new { @class = "btn btn-light" })
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card text-white bg-info mb-3">
                <div class="card-body">
                    <h5 class="card-title">👥 Clientes</h5>
                    <p class="card-text">Gerencie clientes cadastrados</p>
                    @Html.ActionLink("Gerenciar Clientes", "Clientes", "Admin", null, new { @class = "btn btn-light" })
                </div>
            </div>
        </div>
    </div>

   
        <div class="col-md-6">
            <div class="card text-white bg-secondary mb-3">
                <div class="card-body">
                    <h5 class="card-title">➕ Novo Produto</h5>
                    <p class="card-text">Adicione novos produtos ao catálogo</p>
                    @Html.ActionLink("Criar Produto", "CriarProduto", "Admin", null, new { @class = "btn btn-light" })
                </div>
            </div>
        </div>
    </div>
</div>